# Local Django development only. Use a real PostgreSQL database.
SECRET_KEY=replace-with-a-local-development-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Optional first-admin provisioning. Keep disabled locally unless deliberately testing it.
DJANGO_SUPERUSER_ENABLED=false
# Set these only in a protected deployment secret manager; never commit real values.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

DB_NAME=paid_link
DB_USER=postgres
DB_PASSWORD=replace-with-local-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Optionally use this instead of the DB_* values above.
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/paid_link

# Optional Cloudinary credentials for local media operations. Keep placeholders only.
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
