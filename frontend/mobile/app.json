{
  "expo": {
    "name": "ElimuBang",
    "slug": "paidlink",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "paidlink",
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "android": {
      "package": "com.paidlink.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "paidlinkweb.onrender.com",
              "pathPrefix": "/shared/"
            },
            {
              "scheme": "https",
              "host": "paidlinkweb.onrender.com",
              "pathPrefix": "/guest-access/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.paidlink.mobile"
    },
    "extra": {
      "eas": {
        "projectId": "e74e497f-aea4-45e8-9f39-6b846d719326"
      }
    },
    "owner": "engineer25joe"
  }
}
